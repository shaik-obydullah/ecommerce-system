APP_NAME="Ecommerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_VERSION=0.1.0
GIT_COMMIT=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The core always talks to Postgres/Redis inside Compose.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Ecommerce"

# Storefront / store configuration.
STOREFRONT_MODE=blade
STORE_NAME="Ecommerce"
STORE_TIMEZONE=UTC
BASE_CURRENCY=USD
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP

# Initial admin account created by the seeder. Change these before production.
ADMIN_NAME="Store Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

# Sanctum stateful domains (headless mode).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080

# Payments (Phase 4).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# Next.js integration (Phase 5).
INTERNAL_API_URL=http://web
NEXT_PUBLIC_API_URL=http://localhost:8080
REVALIDATE_SECRET=

VITE_APP_NAME="Ecommerce"
