# Compose-level settings. Copy to .env with `make init`.
COMPOSE_PROJECT_NAME=ecommerce
STOREFRONT_MODE=blade

APP_PORT=8080
APP_URL=http://localhost:8080

DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret
POSTGRES_PORT=5432
REDIS_PORT=6379

# Set to 1 to publish the database and Redis ports on the host.
EXPOSE_INFRA_PORTS=1
